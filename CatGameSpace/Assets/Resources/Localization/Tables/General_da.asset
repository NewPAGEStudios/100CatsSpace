  - m_Id: 737005425463296
    m_Localized: Afslut
    m_Metadata:
      m_Items: []
  - m_Id: 737141148946432
    m_Localized: "Forts\xE6t"
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "Er du sikker p\xE5, at du vil afslutte spillet"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: Afslut spil?
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: Er du sikker? Dette vil nulstille alle dine fremskridt
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: "Indl\xE6ser..."
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: Nej
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: Tillykke!
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: "Forts\xE6t til farvetilstand"
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: Tid
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: Singleplayer
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: "Duo / V\xE6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: Annuller
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "Du kan navigere p\xE5 sk\xE6rmen med W-A-S-D-tasterne"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "Du kan flytte den ved at holde h\xF8jre museknap nede"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: Du kan finde kattene med et venstreklik med musen.
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Du kan f\xE5 hj\xE6lp ved at trykke p\xE5 'H' eller tip-knappen
      \xF8verst til venstre"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Tillykke, du kan nu skifte til maletilstand p\xE5 dette tidspunkt!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "Paletten vil hj\xE6lpe dig med din maling."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Eller du kan v\xE6lge og male ved at trykke og holde."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Du er nu klar til at male og finde katte. God forn\xF8jelse!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Andre baner vil v\xE6re tilg\xE6ngelige i den fulde version."
    m_Metadata:
      m_Items: []
