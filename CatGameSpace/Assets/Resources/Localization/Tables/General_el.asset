  - m_Id: 1140296089145344
    m_Localized: "\u039D\u03C4\u03BF\u03C5\u03AD\u03C4\u03BF / \u039F\u03B9\u03BA\u03BF\u03B4\u03B5\u03C3\u03C0\u03CC\u03C4\u03B7\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: "\u0386\u03BA\u03C5\u03C1\u03BF "
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C0\u03BB\u03BF\u03B7\u03B3\u03B7\u03B8\u03B5\u03AF\u03C4\u03B5
      \u03C3\u03C4\u03B7\u03BD \u03BF\u03B8\u03CC\u03BD\u03B7 \u03BC\u03B5 \u03C4\u03B1
      \u03C0\u03BB\u03AE\u03BA\u03C4\u03C1\u03B1 W-A-S-D"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03C4\u03BF
      \u03BC\u03B5\u03C4\u03B1\u03BA\u03B9\u03BD\u03AE\u03C3\u03B5\u03C4\u03B5 \u03BA\u03C1\u03B1\u03C4\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03C0\u03B1\u03C4\u03B7\u03BC\u03AD\u03BD\u03BF \u03C4\u03BF \u03B4\u03B5\u03BE\u03AF
      \u03C0\u03BB\u03AE\u03BA\u03C4\u03C1\u03BF \u03C4\u03BF\u03C5 \u03C0\u03BF\u03BD\u03C4\u03B9\u03BA\u03B9\u03BF\u03CD"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03B2\u03C1\u03B5\u03AF\u03C4\u03B5
      \u03C4\u03B9\u03C2 \u03B3\u03AC\u03C4\u03B5\u03C2 \u03BC\u03B5 \u03AD\u03BD\u03B1
      \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03CC \u03BA\u03BB\u03B9\u03BA \u03C4\u03BF\u03C5
      \u03C0\u03BF\u03BD\u03C4\u03B9\u03BA\u03B9\u03BF\u03CD."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "\u039C\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1 \u03BB\u03AC\u03B2\u03B5\u03C4\u03B5
      \u03B2\u03BF\u03AE\u03B8\u03B5\u03B9\u03B1 \u03C0\u03B1\u03C4\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03C4\u03BF \xABH\xBB \u03AE \u03C4\u03BF \u03BA\u03BF\u03C5\u03BC\u03C0\xED
      \u03C5\u03C0\u03CC\u03B4\u03B5\u03B9\u03BE\u03B7\u03C2 \u03B5\u03C0\u03AC\u03BD\u03C9
      \u03B1\u03C1\u03B9\u03C3\u03C4\u03B5\u03C1\u03AC"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "\u03A3\u03C5\u03B3\u03C7\u03B1\u03C1\u03B7\u03C4\u03AE\u03C1\u03B9\u03B1,
      \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03C4\u03CE\u03C1\u03B1 \u03BD\u03B1
      \u03BC\u03B5\u03C4\u03B1\u03B2\u03B5\u03AF\u03C4\u03B5 \u03C3\u03C4\u03B7 \u03BB\u03B5\u03B9\u03C4\u03BF\u03C5\u03C1\u03B3\u03AF\u03B1
      \u03B6\u03C9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE\u03C2 \u03C3\u03B5 \u03B1\u03C5\u03C4\u03CC
      \u03C4\u03BF \u03C3\u03C4\u03AC\u03B4\u03B9\u03BF!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "\u0397 \u03C0\u03B1\u03BB\u03AD\u03C4\u03B1 \u03B8\u03B1 \u03C3\u03B1\u03C2
      \u03B2\u03BF\u03B7\u03B8\u03AE\u03C3\u03B5\u03B9 \u03BC\u03B5 \u03C4\u03B7
      \u03B6\u03C9\u03B3\u03C1\u03B1\u03C6\u03B9\u03BA\u03AE \u03C3\u03B1\u03C2."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "\u0389 \u03BC\u03C0\u03BF\u03C1\u03B5\u03AF\u03C4\u03B5 \u03BD\u03B1
      \u03B5\u03C0\u03B9\u03BB\u03AD\u03BE\u03B5\u03C4\u03B5 \u03BA\u03B1\u03B9 \u03BD\u03B1
      \u03B6\u03C9\u03B3\u03C1\u03B1\u03C6\u03AF\u03C3\u03B5\u03C4\u03B5 \u03C0\u03B1\u03C4\u03CE\u03BD\u03C4\u03B1\u03C2
      \u03C0\u03B1\u03C1\u03B1\u03C4\u03B5\u03C4\u03B1\u03BC\u03AD\u03BD\u03B1."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "\u0395\u03AF\u03C3\u03C4\u03B5 \u03C4\u03CE\u03C1\u03B1 \u03AD\u03C4\u03BF\u03B9\u03BC\u03BF\u03B9
      \u03BD\u03B1 \u03B6\u03C9\u03B3\u03C1\u03B1\u03C6\u03AF\u03C3\u03B5\u03C4\u03B5
      \u03BA\u03B1\u03B9 \u03BD\u03B1 \u03B2\u03C1\u03B5\u03AF\u03C4\u03B5 \u03B3\u03AC\u03C4\u03B5\u03C2.
      \u039A\u03B1\u03BB\u03AE \u03B4\u03B9\u03B1\u03C3\u03BA\u03AD\u03B4\u03B1\u03C3\u03B7!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: " \u0386\u03BB\u03BB\u03BF\u03B9 \u03C7\u03AC\u03C1\u03C4\u03B5\u03C2
      \u03B8\u03B1 \u03B5\u03AF\u03BD\u03B1\u03B9 \u03B4\u03B9\u03B1\u03B8\u03AD\u03C3\u03B9\u03BC\u03BF\u03B9
      \u03C3\u03C4\u03B7\u03BD \u03C0\u03BB\u03AE\u03C1\u03B7 \u03AD\u03BA\u03B4\u03BF\u03C3\u03B7."
    m_Metadata:
      m_Items: []
