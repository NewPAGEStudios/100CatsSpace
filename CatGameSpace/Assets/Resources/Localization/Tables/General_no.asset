  - m_Id: 737141148946432
    m_Localized: Fortsett
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "Er du sikker p\xE5 at du vil avslutte spillet"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: Avslutte spillet?
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: Er du sikker? Dette vil tilbakestille all fremgangen din
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: Laster...
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: Nei
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: Gratulerer!
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: Fortsett til fargemodus
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: Tid
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: Enspiller
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: Duo / Vert
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: Avbryt
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "Du kan navigere p\xE5 skjermen med W-A-S-D-tastene"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "Du kan flytte den ved \xE5 holde nede h\xF8yre museknapp"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: Du kan finne kattene med et venstre museklikk.
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Du kan f\xE5 hjelp ved \xE5 trykke p\xE5 'H' eller hintknappen
      \xF8verst til venstre"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Gratulerer, du kan n\xE5 bytte til malingsmodus p\xE5 dette stadiet!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: Paletten vil hjelpe deg med maleriet ditt.
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Eller du kan velge og male ved \xE5 trykke og holde."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Du er n\xE5 klar til \xE5 male og finne katter. Ha det g\xF8y!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Andre kart vil v\xE6re tilgjengelige i fullversjonen."
    m_Metadata:
      m_Items: []
