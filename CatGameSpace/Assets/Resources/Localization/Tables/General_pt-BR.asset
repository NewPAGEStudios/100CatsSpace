    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: Continue para o modo de cor
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: Tempo
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: Um jogador
    m_Metadata:
      m_Items: []
