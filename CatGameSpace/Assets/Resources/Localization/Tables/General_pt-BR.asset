    m_Localized: Duo / Host
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: Cancelar
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "Voc\xEA pode navegar na tela com as teclas W-A-S-D"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "Voc\xEA pode mov\xEA-lo segurando o bot\xE3o direito do mouse"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "Voc\xEA pode encontrar os gatos com um clique esquerdo do mouse."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Voc\xEA pode obter ajuda pressionando ''H'' ou o bot\xE3o de dica
      no canto superior esquerdo"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Parab\xE9ns, agora voc\xEA pode mudar para o modo de pintura nesta
      fase!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "A paleta ir\xE1 ajud\xE1-lo com a sua pintura."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Ou voc\xEA pode selecionar e pintar pressionando e segurando."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Agora voc\xEA est\xE1 pronto para pintar e encontrar gatos. Divirta-se!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Outros mapas estar\xE3o dispon\xEDveis na vers\xE3o completa."
    m_Metadata:
      m_Items: []
