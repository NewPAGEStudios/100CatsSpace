  - m_Id: 737005425463296
    m_Localized: Beenden
    m_Metadata:
      m_Items: []
  - m_Id: 737141148946432
    m_Localized: Weiter
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "Sind Sie sicher, dass Sie das Spiel beenden m\xF6chten"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: Spiel beenden?
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: "Bist du sicher? Dadurch wird dein gesamter Fortschritt zur\xFCckgesetzt"
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: Wird geladen...
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: "Herzlichen Gl\xFCckwunsch!"
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: Weiter zum Farbmodus
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: Zeit
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: Einzelspieler
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: Duo / Host
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: Abbrechen
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "Mit den W-A-S-D-Tasten k\xF6nnen Sie auf dem Bildschirm navigieren"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "Sie k\xF6nnen es bewegen, indem Sie die rechte Maustaste gedr\xFCckt
      halten"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "Mit einem Linksklick mit der Maus k\xF6nnen Sie die Katzen finden."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Sie k\xF6nnen Hilfe erhalten, indem Sie ''H'' oder die Hinweistaste
      oben links dr\xFCcken"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Herzlichen Gl\xFCckwunsch, Sie k\xF6nnen jetzt in den Malmodus
      wechseln!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: Die Palette wird Ihnen beim Malen helfen.
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Oder Sie k\xF6nnen ausw\xE4hlen und malen, indem Sie gedr\xFCckt
      halten."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Sie sind jetzt bereit, Katzen zu malen und zu finden. Viel Spa\xDF!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Weitere Karten werden in der Vollversion verf\xFCgbar sein."
    m_Metadata:
      m_Items: []
