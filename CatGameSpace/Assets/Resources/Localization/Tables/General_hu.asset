    m_Metadata:
      m_Items: []
  - m_Id: 694147582595072
    m_Localized: "M\u0171v\xE9szet"
    m_Metadata:
      m_Items: []
  - m_Id: 694220521541632
    m_Localized: "Technikai m\u0171v\xE9szet"
