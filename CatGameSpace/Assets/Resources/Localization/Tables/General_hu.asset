    m_Metadata:
      m_Items: []
  - m_Id: 694753743409152
    m_Localized: Zene
    m_Metadata:
      m_Items: []
  - m_Id: 695000028745728
    m_Localized: "\xDCzenet"
    m_Metadata:
      m_Items: []
  - m_Id: 695138520469504
    m_Localized: "Sz\xF6veg be\xEDr\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 695220611387392
    m_Localized: "\xCDrja be a k\xF3dot"
    m_Metadata:
      m_Items: []
  - m_Id: 697863589138432
    m_Localized: "UI tervez\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 698355476140032
    m_Localized: "Keres\xE9s/Fest\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 698489962303488
    m_Localized: Tipp
    m_Metadata:
      m_Items: []
  - m_Id: 698585680515072
    m_Localized: "Megnyit\xE1s fest\xE9shez"
    m_Metadata:
      m_Items: []
  - m_Id: 698751183556608
    m_Localized: "Kamera mozg\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 698871266480128
    m_Localized: "Nagy\xEDt\xE1s/Kicsiny\xEDt\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 698956498931712
    m_Localized: Vissza
    m_Metadata:
      m_Items: []
  - m_Id: 699007065460736
    m_Localized: "Kiv\xE1laszt\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 699082504212480
    m_Localized: "Eg\xE9r"
    m_Metadata:
      m_Items: []
  - m_Id: 699135130144768
    m_Localized: "Billenty\u0171zet"
    m_Metadata:
      m_Items: []
  - m_Id: 699221184679936
    m_Localized: Gamepad
    m_Metadata:
      m_Items: []
  - m_Id: 699352596418560
    m_Localized: Tartsa lenyomva
    m_Metadata:
      m_Items: []
  - m_Id: 737005425463296
    m_Localized: "Kil\xE9p\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 737141148946432
    m_Localized: "Folytat\xE1s"
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "Biztosan ki akarsz l\xE9pni a j\xE1t\xE9kb\xF3l"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: "Kil\xE9p\xE9s a j\xE1t\xE9kb\xF3l?"
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: "Biztos vagy benne? Ezzel minden el\u0151rehalad\xE1sodat t\xF6rl\xF6d"
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: "Bet\xF6lt\xE9s..."
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Igen
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: Nem
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: "Gratul\xE1lok!"
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: "Folytat\xE1s a Sz\xEDnes m\xF3dba"
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: "Id\u0151"
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: "Egyj\xE1t\xE9kos"
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: "Du\xF3 / H\xE1zigazda"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: "M\xE9gse"
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "A W-A-S-D gombokkal navig\xE1lhat a k\xE9perny\u0151n"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "A jobb eg\xE9rgomb lenyom\xE1s\xE1val mozgathatja"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "A bal eg\xE9rgombbal megtal\xE1lhatod a macsk\xE1kat."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Seg\xEDts\xE9get kaphat az \u201EH\u201D vagy a bal fels\u0151
      sarokban tal\xE1lhat\xF3 tipp gomb megnyom\xE1s\xE1val"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Gratul\xE1lunk, ezen a ponton \xE1tv\xE1lthat a fest\xE9si m\xF3dra!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "A paletta seg\xEDt a fest\xE9sben."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Vagy a lenyomva tart\xE1ssal v\xE1laszthat \xE9s festhet."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Most m\xE1r k\xE9szen \xE1llsz a fest\xE9sre \xE9s a macsk\xE1k
      keres\xE9s\xE9re. J\xF3 sz\xF3rakoz\xE1st!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "A t\xF6bbi p\xE1lya a teljes verzi\xF3ban lesz el\xE9rhet\u0151."
    m_Metadata:
      m_Items: []
  references:
