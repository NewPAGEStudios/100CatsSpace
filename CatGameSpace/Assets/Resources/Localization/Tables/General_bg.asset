  - m_Id: 1140293790666752
    m_Localized: "\u0415\u0434\u0438\u043D\u0438\u0447\u043D\u0430 \u0438\u0433\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: "\u041E\u0442\u043A\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "\u041C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u0441\u0435
      \u0434\u0432\u0438\u0436\u0438\u0442\u0435 \u043F\u043E \u0435\u043A\u0440\u0430\u043D\u0430
      \u0441 \u043A\u043B\u0430\u0432\u0438\u0448\u0438\u0442\u0435 W-A-S-D"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "\u041C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u0433\u043E
      \u043F\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435, \u043A\u0430\u0442\u043E
      \u0437\u0430\u0434\u044A\u0440\u0436\u0438\u0442\u0435 \u0434\u0435\u0441\u043D\u0438\u044F
      \u0431\u0443\u0442\u043E\u043D \u043D\u0430 \u043C\u0438\u0448\u043A\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "\u041C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u043D\u0430\u043C\u0435\u0440\u0438\u0442\u0435
      \u043A\u043E\u0442\u043A\u0438\u0442\u0435 \u0441 \u043B\u044F\u0432 \u043A\u043B\u0438\u043A
      \u043D\u0430 \u043C\u0438\u0448\u043A\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "\u041C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      \u043F\u043E\u043C\u043E\u0449, \u043A\u0430\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435
      \u2018\u2019H\u2019\u2019 \u0438\u043B\u0438 \u0431\u0443\u0442\u043E\u043D\u0430
      \u0437\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430 \u0432
      \u0433\u043E\u0440\u043D\u0438\u044F \u043B\u044F\u0432 \u044A\u0433\u044A\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
      \u0432\u0435\u0447\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430
      \u043F\u0440\u0435\u043C\u0438\u043D\u0435\u0442\u0435 \u043A\u044A\u043C \u0440\u0435\u0436\u0438\u043C
      \u043D\u0430 \u0440\u0438\u0441\u0443\u0432\u0430\u043D\u0435 \u043D\u0430
      \u0442\u043E\u0437\u0438 \u0435\u0442\u0430\u043F!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "\u041F\u0430\u043B\u0438\u0442\u0440\u0430\u0442\u0430 \u0449\u0435
      \u0432\u0438 \u043F\u043E\u043C\u043E\u0433\u043D\u0435 \u0441 \u0440\u0438\u0441\u0443\u0432\u0430\u043D\u0435\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "\u0418\u043B\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0430
      \u0438\u0437\u0431\u0435\u0440\u0435\u0442\u0435 \u0438 \u0440\u0438\u0441\u0443\u0432\u0430\u0442\u0435,
      \u043A\u0430\u0442\u043E \u043D\u0430\u0442\u0438\u0441\u043D\u0435\u0442\u0435
      \u0438 \u0437\u0430\u0434\u044A\u0440\u0436\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "\u0412\u0435\u0447\u0435 \u0441\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u0438
      \u0434\u0430 \u0440\u0438\u0441\u0443\u0432\u0430\u0442\u0435 \u0438 \u043D\u0430\u043C\u0438\u0440\u0430\u0442\u0435
      \u043A\u043E\u0442\u043A\u0438. \u041F\u0440\u0438\u044F\u0442\u043D\u0430
      \u0438\u0433\u0440\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "\u0414\u0440\u0443\u0433\u0438\u0442\u0435 \u043A\u0430\u0440\u0442\u0438
      \u0449\u0435 \u0431\u044A\u0434\u0430\u0442 \u0434\u043E\u0441\u0442\u044A\u043F\u043D\u0438
      \u0432 \u043F\u044A\u043B\u043D\u0430\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u044F."
    m_Metadata:
      m_Items: []
