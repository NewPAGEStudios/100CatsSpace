  - m_Id: 737141148946432
    m_Localized: Continuare
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "Sunte\u021Bi sigur c\u0103 dori\u021Bi s\u0103 p\u0103r\u0103si\u021Bi
      jocul"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: "P\u0103r\u0103si\u021Bi jocul?"
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: "Esti sigur? Acest lucru v\u0103 va reseta toate progresele"
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: "Se \xEEncarc\u0103..."
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: Nu
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: "Felicit\u0103ri!"
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: "Continua\u021Bi la modul Culoare"
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: Timp
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: "Un singur juc\u0103tor"
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: "Duo / Gazd\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: "Anuleaz\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "Pute\u021Bi naviga pe ecran cu tastele W-A-S-D"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "\xCEl pute\u021Bi muta \u021Bin\xE2nd ap\u0103sat butonul drept
      al mouse-ului"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "Pute\u021Bi g\u0103si pisicile cu un clic st\xE2nga al mouse-ului."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Pute\u021Bi ob\u021Bine ajutor ap\u0103s\xE2nd ''H'' sau butonul
      de indiciu din st\xE2nga sus"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Felicit\u0103ri, acum pute\u021Bi comuta la modul pictur\u0103
      \xEEn aceast\u0103 etap\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "Paleta v\u0103 va ajuta la pictur\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Sau pute\u021Bi selecta \u0219i picta prin ap\u0103sare \u0219i
      men\u021Binere."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Acum sunte\u021Bi gata s\u0103 picta\u021Bi \u0219i s\u0103 g\u0103si\u021Bi
      pisici. Distrac\u021Bie pl\u0103cut\u0103!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Alte h\u0103r\u021Bi vor fi disponibile \xEEn versiunea complet\u0103."
    m_Metadata:
      m_Items: []
