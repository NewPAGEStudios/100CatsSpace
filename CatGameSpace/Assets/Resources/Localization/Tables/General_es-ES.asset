  - m_Id: 737568418500608
    m_Localized: "\xBFEst\xE1s seguro de que quieres salir del juego"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: "\xBFSalir del juego?"
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: "\xBFEst\xE1s seguro? Esto restablecer\xE1 todo tu progreso"
