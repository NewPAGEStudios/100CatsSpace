    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: "D\xFAo / Anfitri\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: Cancelar
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: Puede navegar por la pantalla con las teclas W-A-S-D
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "Puede moverlo manteniendo presionado el bot\xF3n derecho del rat\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "Puedes encontrar a los gatos con un clic izquierdo del rat\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Puede obtener ayuda presionando la ''H'' o el bot\xF3n de pista
      en la parte superior izquierda"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "\xA1Felicidades, ya puedes cambiar al modo de pintura en esta etapa!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "La paleta te ayudar\xE1 con tu pintura."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: O puedes seleccionar y pintar manteniendo presionado.
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Ya est\xE1s listo para pintar y encontrar gatos. \xA1Que te diviertas!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Los dem\xE1s mapas estar\xE1n disponibles en la versi\xF3n completa."
    m_Metadata:
      m_Items: []
