  - m_Id: 699352596418560
    m_Localized: "H\xE5ll"
    m_Metadata:
      m_Items: []
  - m_Id: 737005425463296
    m_Localized: Avsluta
    m_Metadata:
      m_Items: []
  - m_Id: 737141148946432
    m_Localized: "Forts\xE4tt"
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "\xC4r du s\xE4ker p\xE5 att du vill avsluta spelet"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: Avsluta spelet?
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: "\xC4r du s\xE4ker? Detta kommer att \xE5terst\xE4lla alla dina
      framsteg"
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: Laddar...
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: Nej
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: Grattis!
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: "Forts\xE4tt till f\xE4rgl\xE4ge"
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: Tid
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: En spelare
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: "Duo / V\xE4rd"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: Avbryt
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "Du kan navigera p\xE5 sk\xE4rmen med W-A-S-D-tangenterna"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "Du kan flytta den genom att h\xE5lla ner h\xF6ger musknapp"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "Du kan hitta katterna med ett v\xE4nsterklick med musen."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "Du kan f\xE5 hj\xE4lp genom att trycka p\xE5 ''H'' eller ledtr\xE5dsknappen
      uppe till v\xE4nster"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Grattis, du kan nu byta till m\xE5lningsl\xE4ge i det h\xE4r skedet!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "Paletten hj\xE4lper dig med din m\xE5lning."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Eller s\xE5 kan du v\xE4lja och m\xE5la genom att trycka och h\xE5lla
      ned."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Du \xE4r nu redo att m\xE5la och hitta katter. Ha s\xE5 kul!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Andra kartor kommer att finnas tillg\xE4ngliga i den fullst\xE4ndiga
      versionen."
    m_Metadata:
      m_Items: []
