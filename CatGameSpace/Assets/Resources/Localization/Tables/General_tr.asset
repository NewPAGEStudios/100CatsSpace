  - m_Id: 695138520469504
    m_Localized: Mesaj giriniz
    m_Metadata:
      m_Items: []
  - m_Id: 697863589138432
    m_Localized: "Aray\xFCz Tasar\u0131m\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 698355476140032
    m_Localized: Bul/Boya
    m_Metadata:
      m_Items: []
  - m_Id: 698489962303488
    m_Localized: "\u0130pucu"
    m_Metadata:
      m_Items: []
  - m_Id: 698585680515072
    m_Localized: "Boyamaya a\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 698751183556608
    m_Localized: Kamera Hareketi
    m_Metadata:
      m_Items: []
  - m_Id: 698871266480128
    m_Localized: "Yak\u0131nla\u015Ft\u0131r/Uzakla\u015Ft\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 698956498931712
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 699007065460736
    m_Localized: "Se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 699082504212480
    m_Localized: Fare
    m_Metadata:
      m_Items: []
  - m_Id: 699135130144768
    m_Localized: Klavye
    m_Metadata:
      m_Items: []
  - m_Id: 699221184679936
    m_Localized: Oyun kolu
    m_Metadata:
      m_Items: []
  - m_Id: 699352596418560
    m_Localized: "Bas\u0131l\u0131 tut"
    m_Metadata:
      m_Items: []
  - m_Id: 737005425463296
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 737141148946432
    m_Localized: Devam et
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "Oyundan \xE7\u0131kmak istedi\u011Fine emin misin ?"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: "Oyundan \xC7\u0131k ?"
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: "Emin misin ? Bu i\u015Flem b\xFCt\xFCn ilerlemeni silecek"
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: "Y\xFCkleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: Tebrikler !
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: "Boyama moduna ge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: "Zaman\t"
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: Tek Oyunculu
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: "\xC7ok Oyunculu"
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: "\u0130ptal"
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "W-A-S-D tu\u015Flar\u0131yla ekranda gezinebilirsiniz"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "Mouse sa\u011F t\u0131k bas\u0131l\u0131 tutarak hareket ettirebilirsiniz"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "Mouse sol t\u0131k\u0131yla kedileri bulabilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "\u2018\u2019H\u2019\u2019 ya da sol \xFCstteki ipucu tu\u015Funa
      basarak yard\u0131m alabilirsiniz"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Tebrikler art\u0131k bu a\u015Famada boyama moduna  ge\xE7ebilirsiniz!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "Palet boyamanda sana yard\u0131mc\u0131 olacak."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Veya bas\u0131l\u0131 tutarak renk se\xE7ebilir ve boyayabilirsiniz."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Art\u0131k boyamaya ve kedileri bulmaya haz\u0131rs\u0131n\u0131z.
      \u0130yi oyunlar !"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Di\u011Fer haritalar tam s\xFCr\xFCmde eri\u015Filebilir olacak."
    m_Metadata:
      m_Items: []
