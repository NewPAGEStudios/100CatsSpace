  - m_Id: 737005425463296
    m_Localized: "Ukon\u010Dit"
    m_Metadata:
      m_Items: []
  - m_Id: 737141148946432
    m_Localized: "Pokra\u010Dovat"
    m_Metadata:
      m_Items: []
  - m_Id: 737568418500608
    m_Localized: "Opravdu chcete hru ukon\u010Dit"
    m_Metadata:
      m_Items: []
  - m_Id: 737591646556160
    m_Localized: "Ukon\u010Dit hru?"
    m_Metadata:
      m_Items: []
  - m_Id: 738020157624320
    m_Localized: "Jsi si jist\xFD? T\xEDmto resetujete ve\u0161ker\xFD sv\u016Fj
      postup"
    m_Metadata:
      m_Items: []
  - m_Id: 739566224216064
    m_Localized: "Na\u010D\xEDt\xE1n\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 742582608269312
    m_Localized: Ano
    m_Metadata:
      m_Items: []
  - m_Id: 742604867440640
    m_Localized: Ne
    m_Metadata:
      m_Items: []
  - m_Id: 746477204082688
    m_Localized: Gratulujeme!
    m_Metadata:
      m_Items: []
  - m_Id: 746807211921408
    m_Localized: "Pokra\u010Dovat do barevn\xE9ho re\u017Eimu"
    m_Metadata:
      m_Items: []
  - m_Id: 1032047838957568
    m_Localized: "\u010Cas"
    m_Metadata:
      m_Items: []
  - m_Id: 1140293790666752
    m_Localized: "Jeden hr\xE1\u010D"
    m_Metadata:
      m_Items: []
  - m_Id: 1140296089145344
    m_Localized: Duo / Hostitel
    m_Metadata:
      m_Items: []
  - m_Id: 1149502238298112
    m_Localized: "Zru\u0161it"
    m_Metadata:
      m_Items: []
  - m_Id: 1554486876508160
    m_Localized: "Na obrazovce se m\u016F\u017Eete pohybovat pomoc\xED kl\xE1ves
      W-A-S-D"
    m_Metadata:
      m_Items: []
  - m_Id: 1554596477865984
    m_Localized: "M\u016F\u017Eete s n\xEDm pohybovat podr\u017Een\xEDm prav\xE9ho
      tla\u010D\xEDtka my\u0161i"
    m_Metadata:
      m_Items: []
  - m_Id: 1554614278492160
    m_Localized: "Ko\u010Dky najdete lev\xFDm kliknut\xEDm my\u0161i."
    m_Metadata:
      m_Items: []
  - m_Id: 1554639259766784
    m_Localized: "N\xE1pov\u011Bdu z\xEDsk\xE1te stisknut\xEDm kl\xE1vesy \u201EH\u201C
      nebo tla\u010D\xEDtka n\xE1pov\u011Bdy vlevo naho\u0159e"
    m_Metadata:
      m_Items: []
  - m_Id: 1554657253330944
    m_Localized: "Gratulujeme, nyn\xED m\u016F\u017Eete v t\xE9to f\xE1zi p\u0159ej\xEDt
      do re\u017Eimu malov\xE1n\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 1554669383258112
    m_Localized: "Paleta v\xE1m pom\u016F\u017Ee s malov\xE1n\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 1554685136063936
    m_Localized: "Nebo m\u016F\u017Eete vybrat a malovat stisknut\xEDm a podr\u017Een\xEDm."
    m_Metadata:
      m_Items: []
  - m_Id: 1554703000604672
    m_Localized: "Nyn\xED jste p\u0159ipraveni malovat a hledat ko\u010Dky. Bavte
      se!"
    m_Metadata:
      m_Items: []
  - m_Id: 2453087265820672
    m_Localized: "Dal\u0161\xED mapy budou dostupn\xE9 v pln\xE9 verzi."
    m_Metadata:
      m_Items: []
